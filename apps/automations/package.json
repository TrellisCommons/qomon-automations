{
  "name": "@trellis/automations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json && cp -R src/generated dist/",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "prisma generate && vitest run",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "job": "node dist/cli.js",
    "job:dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "zod": "^3.24.1",
    "@trellis/address-match-core": "workspace:*",
    "@trellis/qomon-client": "workspace:*",
    "pg": "^8.13.1",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "@types/pg": "^8.11.10"
  }
}
