// Household match job: spaces, runs, planned writes, and the change log.
// Contact ids are Qomon's; no names, addresses, or other contact data are
// stored here.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One campaign's Qomon space. Spaces are configuration: a job always runs
/// against one named space.
model Space {
  /// short name used on the command line (`--space <key>`)
  key                  String    @id
  name                 String
  /// AES-256-GCM with SPACE_SECRET_KEY; never logged or printed
  qomonApiKeyEncrypted String
  /// null uses QOMON_API_BASE
  qomonApiBase         String?
  /// the space switch; turning it on or off is change-logged
  writesEnabled        Boolean   @default(false)
  /// after this instant a run logs that the space is inactive and exits
  activeUntil          DateTime?
  /// contacts whose city is this (or blank) are matched; null matches all
  municipality         String?
  /// stored Presence values that count as a canvass and trigger the match
  canvassedValues      String[]
  /// stored Presence value written to the rest of the household
  householdValue       String    @default("absent")
  /// single-choice custom field, and its stored value, written with every
  /// household value so people (and the job) can tell it from a real knock
  markerField          String    @default("Presence source")
  markerValue          String    @default("household_match")
  /// the marker's value once a person records Presence again on a contact
  /// the job wrote (a custom field cannot be cleared through the API)
  recanvassedValue     String    @default("recanvassed")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  runs JobRun[]

  @@map("space")
}

enum RunKind {
  HOURLY
  BACKFILL
  /// the minutely run: changes since the cursor, then dirty households
  INCREMENTAL
  /// a full fetch that seeds or reconciles the mirror, then dirty households
  SWEEP
}

enum RunStatus {
  RUNNING
  SUCCEEDED
  /// a circuit breaker stopped the run
  TRIPPED
  FAILED
  /// stopped by a signal, or abandoned and settled by a later run
  INTERRUPTED
}

model JobRun {
  id         String    @id @default(cuid())
  job        String
  spaceKey   String
  kind       RunKind
  /// true when every write guard allowed writing
  applying   Boolean
  status     RunStatus @default(RUNNING)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// counts only (fetched, planned, applied, verified, failed, ...), and
  /// `progress` while applying; saved after every batch
  stats      Json?
  error      String?

  space  Space          @relation(fields: [spaceKey], references: [key])
  writes PlannedWrite[]

  @@index([spaceKey, startedAt])
  @@map("job_run")
}

enum WriteStatus {
  PLANNED
  /// re-read before writing: it already had a Presence, or moved
  SKIPPED
  /// change-logged, upsert being sent
  APPLYING
  /// Qomon accepted the upsert (202); not yet seen
  APPLIED
  /// read back with the new value
  VERIFIED
  FAILED
}

/// One change the run decided on. The run's report is built from these.
model PlannedWrite {
  id                  String      @id @default(cuid())
  runId               String
  contactId           Int
  field               String
  valueBefore         String?
  valueAfter          String
  /// the canvassed contact at the same address that triggered this write
  triggerContactId    Int
  reason              String
  status              WriteStatus @default(PLANNED)
  /// the Presence date Qomon gave this write, read back at verification; a
  /// later run compares it to tell this write from a re-recorded visit
  writtenPresenceDate String?
  detail              String?
  updatedAt           DateTime    @updatedAt

  run JobRun @relation(fields: [runId], references: [id])

  @@index([runId, status])
  @@index([contactId])
  @@map("planned_write")
}

/// Append-only audit trail of every change the automation made, to Qomon or
/// to its own switches.
model ChangeLogEntry {
  id            String   @id @default(cuid())
  /// e.g. "QomonContact", "Space"
  subjectType   String
  subjectId     String
  actor         String
  reason        String
  before        Json?
  after         Json?
  at            DateTime @default(now())
  correlationId String

  @@index([subjectType, subjectId])
  @@index([correlationId])
  @@index([at])
  @@map("change_log_entry")
}

/// What the household rules need to know about each contact, kept current by
/// the incremental job (docs/household-match/incremental-design.md). No names
/// or addresses: the household key is stored only as an HMAC.
model ContactMirror {
  spaceKey      String
  contactId     Int
  /// Qomon's UpdatedAt, as Qomon returned it
  updatedAt     String
  inScope       Boolean
  /// HMAC of the address key, or "solo:<contact id>" when the contact has no
  /// usable address (it then forms a household of one)
  householdHash String
  presenceRefId Int?
  presenceValue String?
  presenceDate  String?
  markerRefId   Int?

  @@id([spaceKey, contactId])
  @@index([spaceKey, householdHash])
  @@map("contact_mirror")
}

/// Households to plan again. A household leaves this table only once its
/// writes have settled; failures back off, then quarantine.
model DirtyHousehold {
  spaceKey      String
  householdHash String
  markedAt      DateTime  @default(now())
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  quarantinedAt DateTime?

  @@id([spaceKey, householdHash])
  @@index([spaceKey, quarantinedAt, nextAttemptAt])
  @@map("dirty_household")
}

/// How far the mirror is current. Moves only after the changes up to it are
/// in the mirror and their households are marked dirty.
model SyncCursor {
  spaceKey   String
  job        String
  /// the latest Qomon UpdatedAt ingested
  cursor     String?
  ingestedAt DateTime?
  sweptAt    DateTime?
  /// fingerprint of the key household hashes were made with; a change
  /// forces a sweep that rehashes every contact
  keyId      String?

  @@id([spaceKey, job])
  @@map("sync_cursor")
}

/// Alerts already posted, so each problem posts once, not every minute.
model AlertState {
  spaceKey String
  alertKey String
  raisedAt DateTime @default(now())

  @@id([spaceKey, alertKey])
  @@map("alert_state")
}
