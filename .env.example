# Copy to .env and fill in. .env is gitignored; never commit real values.
# On the droplet this file is /etc/qomon-automations/.env (root-only).

# Postgres.
DATABASE_URL=postgresql://qomon:qomon@localhost:5432/qomon_automations

# Encrypts each space's Qomon API key at rest: `openssl rand -base64 32`.
# Losing it means re-adding every space's key with `space:add`.
SPACE_SECRET_KEY=

# Default Qomon host; a space can override it.
# Use https://incoming-us.qomon.app only if the space's API settings say so.
QOMON_API_BASE=https://incoming.qomon.app
# Requests per second to Qomon (its limit refills at 10/s; at most 9).
# Each write is about three requests.
QOMON_RPS=5

# Hard stop for every Qomon write. Leave false everywhere except the droplet.
QOMON_WRITES_ALLOWED=false
# Circuit breakers. An hourly run that plans more writes than this writes
# nothing and turns the space's writes off.
MAX_WRITES_PER_RUN=500
# Once this many writes were attempted, a larger failed share than this
# stops the run and turns the space's writes off.
MIN_WRITES_FOR_FAILED_SHARE=10
MAX_FAILED_SHARE=0.2
# How long a write may take to show up in Qomon before it counts as failed.
VERIFY_TIMEOUT_SECONDS=120

# Run alerts. Leave blank to skip Slack locally.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# Pinged at the end of each run. Leave blank locally.
HEALTHCHECK_URL=

# Sandbox space key for the qomon-client contract suite only
# (QOMON_SANDBOX=1). The job reads each space's key from the database.
QOMON_API_KEY=
QOMON_SANDBOX=0
