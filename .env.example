# Copy to .env and fill in. .env is gitignored; never commit real values.

# Qomon sandbox space, used by the contract suite and local dry runs.
# Settings > Integrations/API in the sandbox space.
QOMON_API_KEY=
# Use https://incoming-us.qomon.app only if the space's API settings say so.
QOMON_API_BASE=https://incoming.qomon.app
# Set to 1 to run the contract suite against the sandbox space.
QOMON_SANDBOX=0

# Hard stop for every Qomon write. Leave false everywhere except the droplet.
QOMON_WRITES_ALLOWED=false
# Circuit breaker: a run that plans more writes than this writes nothing.
MAX_WRITES_PER_RUN=500

# Local Postgres (docker compose).
DATABASE_URL=postgresql://qomon:qomon@localhost:5432/qomon_automations

# Run alerts. Leave blank to skip Slack locally.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# Pinged at the end of each run. Leave blank locally.
HEALTHCHECK_URL=
